<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emits the conformance vector for art of rally's steering force curve.

    Deliberately NOT in ArtOfSimRally.sln: that solution builds against the local
    Steam install's game assemblies, and this must build anywhere, including on a
    machine that has never had the game. Run it with "dotnet run" against this
    project file, passing the output path; tools/force-vector/README.md has the
    exact command, which cannot be written here because an XML comment may not
    contain a double hyphen.

    It links src\ArtOfSimRally.Mod\ForceCurve.cs rather than copying it, so the
    vector is generated by the code the mod actually ships. A transcription would
    only prove that two transcriptions agree.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ForceVector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\ArtOfSimRally.Mod\ForceCurve.cs" Link="ForceCurve.cs" />
  </ItemGroup>

</Project>
