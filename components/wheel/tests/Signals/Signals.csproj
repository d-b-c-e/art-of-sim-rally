<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\artofrally</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ArtOfSimRally.Mod/TelemetrySampling.cs" Link="TelemetrySampling.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/artofrally_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Dbce.Wheel.Telemetry"><HintPath>../../lib/toolkit/dotnet/Dbce.Wheel.Telemetry.dll</HintPath></Reference>
  </ItemGroup>
</Project>
